# 依赖与构建产物
node_modules/
dist/
build/
out/
.turbo/
coverage/
*.tsbuildinfo

# 运行数据（数据库、上传的素材、B站登录信息）——不能进仓库
data/
*.db
*.db-*
.env
.env.*
!.env.example

# 日志
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Python 工具的虚拟环境
.venv/
__pycache__/

# 设计预览的字体文件（从 Google 下载，可用 design/tools/fetch_fonts.py 重新获取）
design/preview/**/fonts/*.woff2

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
