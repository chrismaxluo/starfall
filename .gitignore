# 依赖与构建产物
node_modules/
dist/
build/
out/
.turbo/
coverage/
*.tsbuildinfo

# 运行数据（数据库、上传的素材、B站登录信息）——不能进仓库
data/
*.db
*.db-*
.env
.env.*
!.env.example

# 日志
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Python 工具的虚拟环境
.venv/
__pycache__/

# 设计预览的生成物：字体（design/tools/fetch_fonts.py）、需求文档网页（design/tools/md2html.py）
design/preview/assets/*
!design/preview/assets/logo.svg
design/preview/docs/

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 技术验证抓到的原始消息（含其他观众的信息，不进仓库；脱敏后的样本放 fixtures/）
spike/captures/

# 技术验证用的测试页（含 B 站礼物动画，不进仓库）
design/preview/lab/
